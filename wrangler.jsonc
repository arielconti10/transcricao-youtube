{
  "$schema": "https://unpkg.com/wrangler@4.113.0/config-schema.json",
  "name": "transcricao-youtube",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["GEMINI_API_KEY", "SITE_PASSWORD"]
  }
}
